{
  "name": "pos-hpp-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode testing",
    "dev:prod": "vite --mode production",
    "build": "tsc -b && vite build --mode production",
    "build:testing": "tsc -b && vite build --mode testing",
    "build:prod": "tsc -b && vite build --mode production",
    "apk:testing": "npm run build:testing && npx cap sync android",
    "apk:prod": "npm run build:prod && npx cap sync android",
    "publish:ota": "node scripts/publish-ota.mjs",
    "publish:ota:prod": "node scripts/publish-ota.mjs --prod",
    "upload:apk:testing": "node scripts/upload-apk.mjs",
    "upload:apk:prod": "node scripts/upload-apk.mjs --prod",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/push-notifications": "^8.1.3",
    "@capgo/capacitor-updater": "^8.54.2",
    "@supabase/supabase-js": "^2.119.2",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.76.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "uuid": "^14.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@tailwindcss/vite": "^4.3.5",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "adm-zip": "^0.6.1",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  }
}
